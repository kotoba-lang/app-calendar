(ns calendar.update
  "calendar 更新判定コア — itonami dapp bundle（pure, :effects #{}）。

  イベント更新の競合・パッチ・シーケンス規則の判定
  （正本: lg/src/lg_calendar/handlers.cljk の update-event / create-event の
  デフォルト、mapping.cljc の defaults）。

  - **ifSequence 競合規則**（ETag ← :cal/sequence の中身）: ifSequence が
    与えられ、stored の cal/sequence と違えば **conflict**（= 412）。
    not found は notFound。どちらも fail closed。
  - **パッチは present かつ some のフィールドだけ**（白名单内）。
  - 更新は sequence を **inc** し、create のデフォルト sequence は 0。

  update-judgment の戻り: 0 = 進行 / 1 = not-found / 2 = conflict
  patch-admissible: 1 = パッチ可（present かつ some）
  default-of の戻り: 0 allDay=false / 1 visibility=private / 2 status=confirmed
    / 3 sequence=0 / 4 calendarId=primary / それ以外 = -1

  実行 host はスカラーのみ = KIR v3 / i64/direct ABI（kernel/selfhost 両対応）。

  テストはゼロ引数 test-*、戻り 1/0:
  <amu> test aiueos/calendar_update.cljk"
  (:export [main update-judgment patch-admissible next-sequence default-of
            test-not-found test-conflict test-match test-no-ifseq
            test-patch test-sequence test-defaults test-fail-closed]))

(defn main [] :i64
  0)

(defn update-judgment [has-event :i64 has-if-seq :i64 stored-seq :i64 if-seq :i64] :i64
  (if (= has-event 0)
    1
    (if (and (= has-if-seq 1) (not= stored-seq if-seq))
      2
      0)))

(defn patch-admissible [present :i64 some-val :i64] :i64
  (if (and (= present 1) (= some-val 1)) 1 0))

(defn next-sequence [stored-seq :i64] :i64
  (+ stored-seq 1))

(defn default-of [field-code :i64] :i64
  (if (= field-code 0) 0
    (if (= field-code 1) 1
      (if (= field-code 2) 2
        (if (= field-code 3) 0
          (if (= field-code 4) 3 -1))))))

;; --- tests（戻り 1 = pass） ------------------------------------------------

(defn test-not-found [] :i64
  (if (= (update-judgment 0 1 3 3) 1) 1 0))

(defn test-conflict [] :i64
  ;; ifSequence が stored と違えば conflict（= 412）
  (if (= (update-judgment 1 1 3 2) 2) 1 0))

(defn test-match [] :i64
  (if (= (update-judgment 1 1 3 3) 0) 1 0))

(defn test-no-ifseq [] :i64
  ;; ifSequence 無しは競合判定しない（0 = 進行）
  (if (= (update-judgment 1 0 3 0) 0) 1 0))

(defn test-patch [] :i64
  ;; present かつ some のときだけパッチ可
  (if (= (+ (patch-admissible 1 1) (patch-admissible 1 0) (patch-admissible 0 1) (patch-admissible 0 0)) 1) 1 0))

(defn test-sequence [] :i64
  ;; 更新は inc、create デフォルトは 0（default-of 3）
  (if (= (+ (next-sequence 3) (default-of 3)) 4) 1 0))

(defn test-defaults [] :i64
  ;; allDay=false / visibility=private / status=confirmed / calendarId=primary
  (if (= (+ (default-of 0) (default-of 1) (default-of 2) (default-of 4)) 6) 1 0))

(defn test-fail-closed [] :i64
  ;; 未知フィールドのデフォルトは -1（既定を作らない）
  (if (= (default-of 9) -1) 1 0))
