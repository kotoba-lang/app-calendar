(ns calendar.page
  "calendar ページング・削除判定コア — itonami dapp bundle（pure, :effects #{}）。

  （正本: lg/src/lg_calendar/handlers.cljk の list-events / delete-event）。

  - canonical 応答の **offset / limit / total** 三つ組から次ページの有無を
    判定（Google の nextPageToken / MS の @odata.nextLink はスキンがこの
    判定から組み立てる = バイト互換の核心）。
  - デフォルト: offset 0 / limit 50（->int の nil は default）。
  - startsAt 窓: startsAfter は**以上**、startsBefore は**未満**。
  - delete も update と同じ ifSequence 競合規則（不一致 = conflict = 412）。

  has-next-page: 1 = 次ページ有り（offset + limit < total）
  range-judgment の戻り: 1 = 窓内（残す）/ 0 = 窓外
  delete-judgment の戻り: 0 = 削除可 / 1 = not-found / 2 = conflict

  実行 host はスカラーのみ = KIR v3 / i64/direct ABI（kernel/selfhost 両対応）。

  テストはゼロ引数 test-*、戻り 1/0:
  <amu> test aiueos/calendar_page.cljk"
  (:export [main has-next-page page-default range-judgment delete-judgment
            test-next test-no-next test-defaults test-range test-delete
            test-delete-conflict test-delete-missing test-fail-closed]))

(defn main [] :i64
  0)

(defn has-next-page [offset :i64 limit :i64 total :i64] :i64
  (if (< (+ offset limit) total) 1 0))

(defn page-default [which :i64] :i64
  (if (= which 0) 0
    (if (= which 1) 50 -1)))

(defn range-judgment [has-after :i64 ge-after :i64 has-before :i64 lt-before :i64] :i64
  ;; startsAfter は以上、startsBefore は未満。無指定の側は無条件で通す
  (if (and (if (= has-after 1) (= ge-after 1) true)
           (if (= has-before 1) (= lt-before 1) true))
    1 0))

(defn delete-judgment [has-event :i64 has-if-seq :i64 stored-seq :i64 if-seq :i64] :i64
  (if (= has-event 0)
    1
    (if (and (= has-if-seq 1) (not= stored-seq if-seq))
      2
      0)))

;; --- tests（戻り 1 = pass） ------------------------------------------------

(defn test-next [] :i64
  ;; 0/50/100 → 次有り
  (if (= (has-next-page 0 50 100) 1) 1 0))

(defn test-no-next [] :i64
  ;; 50/50/100、0/50/50、60/50/100 → 次無し
  (if (= (+ (has-next-page 50 50 100) (has-next-page 0 50 50) (has-next-page 60 50 100)) 0) 1 0))

(defn test-defaults [] :i64
  ;; offset 0 / limit 50
  (if (= (+ (page-default 0) (page-default 1)) 50) 1 0))

(defn test-range [] :i64
  ;; startsAfter 以上・startsBefore 未満。無指定は無条件
  (if (= (+ (range-judgment 1 1 1 1) (range-judgment 0 0 0 0)
            (range-judgment 1 1 0 0) (range-judgment 0 0 1 1))
         4)
    1 0))

(defn test-delete [] :i64
  (if (= (delete-judgment 1 1 3 3) 0) 1 0))

(defn test-delete-conflict [] :i64
  (if (= (delete-judgment 1 1 3 2) 2) 1 0))

(defn test-delete-missing [] :i64
  (if (= (delete-judgment 0 0 0 0) 1) 1 0))

(defn test-fail-closed [] :i64
  ;; 窓の片側だけ満たしても残さない
  (if (= (+ (range-judgment 1 0 1 1) (range-judgment 1 1 1 0) (range-judgment 1 0 1 0)) 0) 1 0))
