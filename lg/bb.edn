{;; Scoped babashka project for the lg-calendar clj port (ADR-2606280030:
 ;; langgraph-python -> langgraph-clj). Self-contained — does NOT touch the
 ;; repo-root bb.edn. The cljc namespaces (lg-calendar.*) load under bb; the
 ;; health graph uses io.github.com-junkawasaki/langgraph-clj (a StateGraph).
 :paths ["src" "test"]
 :deps {com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj"
         :git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}
        com-junkawasaki/langchain-clj
        {:git/url "https://github.com/com-junkawasaki/langchain-clj"
         :git/sha "2b03859c3ee722b64f3eddd0b615a54019b17c81"}}
 :tasks
 {test {:doc "Run the lg-calendar clojure.test suite."
        :task (load-file "run_tests.clj")}
  serve {:doc "Start the lg-calendar HTTP server (httpkit)."
         :task (do (require 'lg-calendar.server)
                   (apply (resolve 'lg-calendar.server/-main) *command-line-args*))}}}
